{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphrun.dev/schemas/glyphrun.config.v1.schema.json",
  "title": "Glyphrun Config v1",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "defaultEnvironment": { "type": "string", "minLength": 1 },
    "artifactRoot": { "type": "string", "minLength": 1 },
    "snapshotRoot": { "type": "string", "minLength": 1 },
    "schemaRoot": { "type": "string", "minLength": 1 },
    "environments": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/environment" }
    },
    "terminal": { "$ref": "#/$defs/terminal" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "redaction": { "$ref": "#/$defs/redaction" },
    "retention": { "$ref": "#/$defs/retention" }
  },
  "additionalProperties": false,
  "$defs": {
    "environment": {
      "type": "object",
      "properties": {
        "vars": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "secrets": { "$ref": "#/$defs/secrets" }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "description": "Declare a TinyVault env-group (or direct project) whose bounded resolved secrets are injected into the run environment at start time. The config carries only identifiers and selectors — never secret values or TinyVault credentials.",
      "properties": {
        "provider": { "type": "string", "enum": ["tvault"], "default": "tvault" },
        "binary": { "type": "string", "minLength": 1, "description": "Path to the tvault executable (defaults to 'tvault' on PATH)" },
        "group": { "type": "string", "minLength": 1, "description": "tvault environment group name" },
        "env": { "type": "string", "minLength": 1, "description": "Environment name within the group" },
        "project": { "type": "string", "minLength": 1, "description": "Direct tvault project name (mutually exclusive with group+env)" },
        "only": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Allowlist of secret keys to inject (least privilege)"
        },
        "prefix": { "type": "string", "minLength": 1, "description": "Inject only keys with this prefix" }
      },
      "additionalProperties": false,
      "allOf": [
        { "oneOf": [
          {
            "required": ["group", "env"],
            "not": { "required": ["project"] }
          },
          {
            "required": ["project"],
            "not": {
              "anyOf": [
                { "required": ["group"] },
                { "required": ["env"] }
              ]
            }
          }
        ] },
        { "anyOf": [
          { "required": ["only"] },
          { "required": ["prefix"] }
        ] }
      ]
    },
    "terminal": {
      "type": "object",
      "properties": {
        "profile": { "enum": ["xterm-256color", "vt100", "ansi"] },
        "cols": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "normalize": { "$ref": "#/$defs/normalize" }
      },
      "additionalProperties": false
    },
    "normalize": {
      "type": "object",
      "properties": {
        "trimRight": { "type": "boolean" },
        "normalizeLineEndings": { "type": "boolean" },
        "hideCursorInTextSnapshots": { "type": "boolean" },
        "stripAnsiTitle": { "type": "boolean" },
        "ignoreCursorVisibility": { "type": "boolean" },
        "replace": {
          "type": "array",
          "items": { "$ref": "#/$defs/normalizeReplace" }
        },
        "ignoreRegions": {
          "type": "array",
          "items": { "$ref": "#/$defs/normalizeIgnoreRegion" }
        }
      },
      "additionalProperties": false
    },
    "normalizeReplace": {
      "type": "object",
      "required": ["regex", "with"],
      "properties": {
        "regex": { "type": "string", "minLength": 1 },
        "with": { "type": "string" }
      },
      "additionalProperties": false
    },
    "normalizeIgnoreRegion": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "rawLog": { "type": "boolean" },
        "frames": { "type": "boolean" },
        "finalScreen": { "type": "boolean" },
        "snapshots": { "type": "boolean" },
        "agentContext": { "type": "boolean" },
        "maxRawLogBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "envAllowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "patterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/redactionPattern" }
        }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "description": "Run-directory retention. keepRuns defaults to 3 when omitted; 0 disables auto-prune. archive routes pruned dirs to an external command (e.g. fcheap) instead of deleting them.",
      "properties": {
        "keepRuns": { "type": "integer", "minimum": 0, "description": "Number of newest run dirs to keep. Default 3; 0 disables auto-prune." },
        "archive": {
          "type": "object",
          "description": "External archival of pruned run directories. fcheap-publish packages the complete run as a deterministic tar.gz and removes it only after an exact credential-free receipt match.",
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "type": "string", "enum": ["fcheap-publish"], "description": "Publish a complete deterministic tar.gz of at most 2 MiB and delete only after a credential-free receipt exactly matches its SHA-256 and size." },
            "command": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "timeout": { "type": "string", "description": "Duration string e.g. 5m, 30s. Default 5m." },
            "retentionDays": { "type": "integer", "minimum": 1, "maximum": 31, "default": 7, "description": "Remote file.cheap lifetime for fcheap-publish evidence packs. Defaults to 7 days." }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "fcheap-publish" } }, "required": ["mode"] },
              "then": { "required": ["command"], "not": { "required": ["args"] } }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "redactionPattern": {
      "type": "object",
      "required": ["name", "regex", "replace"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "regex": { "type": "string", "minLength": 1 },
        "replace": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
